# Copy to .env for local development, then fill in local secrets. Never commit .env.
NODE_ENV=development
PORT=4000
MONGODB_URI=
# Optional DNS server IPs for Node MongoDB SRV lookups, comma-separated.
MONGODB_DNS_SERVERS=
JWT_SECRET=
JWT_EXPIRES_IN=8h
CLIENT_ORIGIN=http://localhost:3000
VITE_API_BASE_URL=
# Local HTTP uses lax/false. Managed HTTPS Preview and production use none/true.
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
CANCELLATION_CUTOFF_HOURS=24

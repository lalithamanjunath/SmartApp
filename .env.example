# Copy to .env for local development and fill in these values. Never commit .env.
MONGODB_URI=
JWT_SECRET=
# Local development accepts the Vite dev server origin; production must also allow the deployed Vercel origin.
CLIENT_ORIGIN=http://localhost:3000,https://smartapp-s388.vercel.app
CLIENT_APP_URL=http://localhost:3000
VITE_API_BASE_URL=
# Required for authentication to work over local HTTP.
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
# Resend credentials and signing secret are private backend environment variables.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
EMAIL_ENCRYPTION_KEY=
